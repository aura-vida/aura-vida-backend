SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PORT=5000

# AWS S3 — see docs/AWS_S3_SETUP.md for bucket/IAM setup
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=

# Optional: CloudFront (or other CDN) domain in front of the bucket.
# Leave blank to serve images directly from the bucket's own URL.
AWS_CLOUDFRONT_DOMAIN=
